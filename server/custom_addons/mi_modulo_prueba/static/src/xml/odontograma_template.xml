<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odontograma.OdontogramaWidget">
        <div class="o_odontograma_wrapper shadow-sm border rounded">
            <!-- Sidebar Compacta -->
            <div class="o_odontograma_sidebar p-2 border-end shadow-sm">
                <span class="o_section_header">Dentadura</span>
                <div class="btn-group btn-group-sm w-100 mb-2 shadow-sm">
                    <button class="btn btn-outline-primary" t-att-class="{'active': state.tipo === 'perm'}" t-on-click="() => this.state.tipo = 'perm'">Perm.</button>
                    <button class="btn btn-outline-primary" t-att-class="{'active': state.tipo === 'temp'}" t-on-click="() => this.state.tipo = 'temp'">Temp.</button>
                </div>

                <span class="o_section_header">Estado</span>
                <div class="mb-3 d-flex flex-column gap-1">
                    <t t-foreach="[['white','Borrar'],['black','Externo'],['blue','Presup.'],['red','Pendiente'],['#00ff00','Realizado']]" t-as="c" t-key="c[0]">
                        <div class="o_color_row d-flex align-items-center gap-2" t-on-click="() => this.state.colorSeleccionado = c[0]" t-att-class="{'active_color': state.colorSeleccionado === c[0]}">
                            <div t-attf-style="width:10px; height:10px; background:{{c[0]}}; border-radius:50%; border:1px solid #ccc;"/>
                            <span class="small" t-esc="c[1]"/>
                        </div>
                    </t>
                </div>

                <span class="o_section_header">Acciones Técnicas</span>
                <div class="o_actions_grid">
                    <button class="o_btn_odont" t-on-click="() => this.state.modo = 'caries'" t-att-class="{'active': state.modo === 'caries'}">
                        <i class="fa fa-paint-brush text-danger"/> Pintar
                    </button>
                    <button class="o_btn_odont" t-on-click="() => this.state.modo = 'corona'" t-att-class="{'active': state.modo === 'corona'}">
                        <i class="fa fa-shield text-info"/> Corona
                    </button>
                    <button class="o_btn_odont" t-on-click="() => this.state.modo = 'perno'" t-att-class="{'active': state.modo === 'perno'}">
                        <i class="fa fa-paper-plane text-warning"/> Perno
                    </button>
                    <button class="o_btn_odont" t-on-click="() => this.state.modo = 'rx'" t-att-class="{'active': state.modo === 'rx'}">
                        <i class="fa fa-camera text-muted"/> RX
                    </button>
                    <button class="o_btn_odont" t-on-click="() => this.state.modo = 'endodoncia'" t-att-class="{'active': state.modo === 'endodoncia'}">
                        <i class="fa fa-arrow-down text-primary"/> Endo
                    </button>
                    <button class="o_btn_odont" t-on-click="() => this.state.modo = 'implante'" t-att-class="{'active': state.modo === 'implante'}">
                        <i class="fa fa-wrench text-secondary"/> Implante
                    </button>
                    <button class="o_btn_odont" t-on-click="() => this.state.modo = 'ausente'" t-att-class="{'active': state.modo === 'ausente'}">
                        <i class="fa fa-times text-danger"/> Ausente
                    </button>
                    <button class="o_btn_odont" t-on-click="() => this.state.modo = 'sellante'" t-att-class="{'active': state.modo === 'sellante'}">
                        <i class="fa fa-tint text-info"/> Sellante
                    </button>
                    <button class="o_btn_odont" t-on-click="() => this.state.modo = 'soportes'" t-att-class="{'active': state.modo === 'soportes'}">
                        <i class="fa fa-th text-muted"/> Brack.
                    </button>
                    <button class="o_btn_odont" t-on-click="() => this.state.modo = 'otro'" t-att-class="{'active': state.modo === 'otro'}">
                        <i class="fa fa-plus text-success"/> Otro...
                    </button>
                </div>
            </div>

            <!-- Canvas Responsivo -->
            <div class="o_odontograma_canvas">
                <div class="o_fila mb-4">
                    <t t-foreach="getDientes('sup')" t-as="dId" t-key="dId">
                        <t t-call="odontograma.DienteSVG">
                            <t t-set="id" t-value="dId"/>
                            <t t-set="esSup" t-value="true"/>
                        </t>
                    </t>
                </div>
                <div class="o_fila">
                    <t t-foreach="getDientes('inf')" t-as="dId" t-key="dId">
                        <t t-call="odontograma.DienteSVG">
                            <t t-set="id" t-value="dId"/>
                            <t t-set="esSup" t-value="false"/>
                        </t>
                    </t>
                </div>
            </div>
        </div>
    </t>

    <t t-name="odontograma.DienteSVG">
        <div class="o_diente_box" t-att-data-id="id">
            <span class="o_num" t-if="esSup" t-esc="id"/>
            <svg viewBox="0 0 50 145" class="o_diente_svg" t-on-click="(ev) => this.onDienteClick(id, ev)">
                <g transform="translate(0, 5)">
                    <path class="o_root" d="M10,40 Q25,120 40,40 Z" t-attf-transform="{{esSup ? '' : 'rotate(180, 25, 60)'}}" fill="#fcfcfc" stroke="#adb5bd" stroke-width="1.2"/>
                    
                    <path t-if="hasTratamiento(id, 'sellante')" 
                          t-attf-transform="translate(15, {{esSup ? 15 : 95}}) scale(0.9)" 
                          d="M10 0C10 0 0 12.2 0 17.7C0 24.5 4.5 30 10 30C15.5 30 20 24.5 20 17.7C20 12.2 10 0 10 0Z" 
                          fill="#00A09D" opacity="0.8"/>

                    <g t-if="hasTratamiento(id, 'soportes')" t-attf-transform="translate(15, {{esSup ? 15 : 95}})">
                        <rect width="20" height="20" fill="#adb5bd" stroke="#444" stroke-width="1"/>
                        <line x1="0" y1="10" x2="20" y2="10" stroke="#444"/>
                        <line x1="10" y1="0" x2="10" y2="20" stroke="#444"/>
                    </g>

                    <path t-if="hasTratamiento(id, 'corona')" d="M8,38 Q25,110 42,38" fill="none" stroke="#666" stroke-width="5" t-attf-transform="{{esSup ? '' : 'rotate(180, 25, 60)'}}"/>
                    
                    <line t-if="hasTratamiento(id, 'perno')" x1="25" y1="45" x2="25" y2="85" stroke="#444" stroke-width="4" t-attf-transform="{{esSup ? '' : 'rotate(180, 25, 60)'}}"/>

                    <text t-if="hasTratamiento(id, 'implante')" x="10" y="80" font-size="28">🔩</text>

                    <line t-if="hasTratamiento(id, 'endodoncia')" x1="25" y1="45" x2="25" y2="105" stroke="#dc3545" stroke-width="5" stroke-linecap="round" t-attf-transform="{{esSup ? '' : 'rotate(180, 25, 60)'}}"/>

                    <path t-if="hasTratamiento(id, 'ausente')" d="M5,10 L45,110 M45,10 L5,110" stroke="#dc3545" stroke-width="3"/>

                    <text t-if="hasTratamiento(id, 'otro')" x="35" y="15" font-size="16" fill="#ff9800" font-weight="bold">✚</text>

                    <g t-attf-transform="translate(5, {{esSup ? 5 : 85}})">
                        <polygon points="0,0 40,0 30,10 10,10" class="o_cara" t-attf-style="fill: {{getDienteColor(id, 'c1')}}" t-on-click.stop="(ev) => this.onCaraClick(id, 'c1', ev)"/>
                        <polygon points="40,0 40,40 30,30 30,10" class="o_cara" t-attf-style="fill: {{getDienteColor(id, 'c2')}}" t-on-click.stop="(ev) => this.onCaraClick(id, 'c2', ev)"/>
                        <polygon points="40,40 0,40 10,30 30,30" class="o_cara" t-attf-style="fill: {{getDienteColor(id, 'c3')}}" t-on-click.stop="(ev) => this.onCaraClick(id, 'c3', ev)"/>
                        <polygon points="0,40 0,0 10,10 10,30" class="o_cara" t-attf-style="fill: {{getDienteColor(id, 'c4')}}" t-on-click.stop="(ev) => this.onCaraClick(id, 'c4', ev)"/>
                        <rect x="10" y="10" width="20" height="20" class="o_cara" t-attf-style="fill: {{getDienteColor(id, 'c5')}}" t-on-click.stop="(ev) => this.onCaraClick(id, 'c5', ev)"/>
                    </g>
                </g>

                <g t-if="hasTratamiento(id, 'rx')" transform="translate(5, 128)">
                    <rect width="40" height="14" rx="3" fill="#6610f2"/>
                    <text x="11" y="11" font-size="9" fill="white" font-weight="bold">RX</text>
                </g>
            </svg>
            <span class="o_num" t-if="!esSup" t-esc="id"/>
        </div>
    </t>
</templates>