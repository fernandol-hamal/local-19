<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mi_modulo_prueba.AudioRecorderField">
        <div class="o_audio_recorder_container">
            <!-- BOTÓN DE GRABAR -->
            <button type="button" 
                    class="btn-wapp-mic" 
                    t-att-class="{'is-recording': state.isRecording}"
                    t-on-click="toggleRecording"
                    title="Haga clic para grabar o detener">
                <i t-if="!state.isRecording" class="fa fa-microphone"></i>
                <i t-if="state.isRecording" class="fa fa-stop"></i>
            </button>
            
            <!-- INDICADOR DE GRABANDO -->
            <div t-if="state.isRecording" class="recording-indicator ms-2">
                <span class="red-dot"></span> Grabando...
            </div>

            <!-- REPRODUCTOR Y BOTÓN DESCARTAR -->
            <div t-if="state.audioUrl and !state.isRecording" class="d-flex align-items-center gap-2 ms-2">
                <audio controls="1" t-att-src="state.audioUrl" class="custom-audio-player"/>
                
                <button type="button" class="btn-clear-audio" t-on-click="clearRecording" title="Descartar grabación">
                    <i class="fa fa-trash"></i>
                </button>
            </div>

            <!-- ERROR (Si el navegador bloquea el micro) -->
            <div t-if="state.errorMsg" class="text-danger ms-2" style="font-size: 0.9em;">
                <i class="fa fa-exclamation-triangle"></i> <t t-esc="state.errorMsg"/>
            </div>
        </div>
    </t>
</templates>