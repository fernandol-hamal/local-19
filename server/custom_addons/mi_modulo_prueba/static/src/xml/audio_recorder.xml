<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mi_modulo_prueba.AudioRecorderField">
        <div class="o_audio_recorder_container o_field_widget w-100">
            <div class="d-flex align-items-center gap-3 w-100">
                <button type="button" 
                        class="btn-wapp-mic" 
                        t-att-class="{'is-recording': state.isRecording}"
                        t-on-click="toggleRecording">
                    <i t-if="!state.isRecording" class="fa fa-microphone"></i>
                    <i t-if="state.isRecording" class="fa fa-stop"></i>
                </button>

                <div class="recorder-content-area flex-grow-1">
                    <div t-if="state.isRecording" class="live-transcription">
                        <canvas t-ref="waveCanvas" class="wave-mini"></canvas>
                        <span class="text-muted italic"><t t-esc="state.interimText"/></span>
                    </div>
                    
                    <div t-if="!state.isRecording" class="final-text">
                        <t t-if="props.record.data[props.name]">
                            <i class="fa fa-quote-left text-silver me-2"></i>
                            <t t-esc="props.record.data[props.name]"/>
                        </t>
                        <t t-else="">
                            <span class="text-silver">Presione para dictar...</span>
                        </t>
                    </div>
                </div>

                <button t-if="props.record.data[props.name] &amp;&amp; !state.isRecording" 
                        type="button" class="btn-clear-audio" t-on-click="clearContent">
                    <i class="fa fa-trash"></i>
                </button>
            </div>
        </div>
    </t>
</templates>