<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mi_modulo_prueba.AudioRecorderField">
        <div class="o_field_widget w-100">
            <div class="d-flex align-items-center mb-2 p-3 rounded" 
                 t-attf-style="background: #{state.isRecording ? '#064e3b' : (state.isListening ? '#1e3a8a' : '#111827')}; border: 1px solid #334155;">
                <button type="button" 
                        t-attf-class="btn rounded-circle me-3"
                        t-attf-style="width: 45px; height: 45px; background: #{state.isRecording ? '#10b981' : '#3b82f6'}; color: white; border: none;"
                        t-on-click="toggleMicrophone">
                    <i t-attf-class="fa #{state.isListening ? 'fa-stop' : 'fa-microphone'}"></i>
                </button>
                <div class="flex-grow-1">
                    <div class="fw-bold text-white small">
                        <t t-if="!state.isListening">SISTEMA APAGADO</t>
                        <t t-elif="!state.isRecording">DIGA "HOLA" PARA ACTIVAR</t>
                        <t t-else="">GRABANDO CONSULTA...</t>
                    </div>
                    <div class="text-info small"><t t-esc="state.interimText"/></div>
                </div>
            </div>
            <textarea class="o_input w-100 p-3" 
                      t-att-name="props.name"
                      t-att-value="props.record.data[props.name] || ''"
                      style="background: #0f172a; color: #f8fafc; border-radius: 8px; min-height: 150px;"/>
        </div>
    </t>
</templates>