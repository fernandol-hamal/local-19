<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pacientes_list" model="ir.ui.view">
        <field name="name">pacientes.list</field>
        <field name="model">pacientes</field>
        <field name="arch" type="xml">
            <list string="Lista de la historia clinica de los pacientes">
                <field name="nom_paciente"/>
                <field name="ape_paciente"/>
                <field name="edad"></field>
                <field name="dni"></field>
                <field name="telf_principal"></field>
                <field name="email"></field>
            </list>
        </field>
    </record>

    <record id="view_pacientes_form" model="ir.ui.view">
        <field name="name">pacientes.list</field>
        <field name="model">pacientes</field>
        <field name="arch" type="xml">
            <form string='Formulario de la historia clinica de los pacientes'>
            <style>
                .o_form_sheet {
                                        max-width: 75% !important;
                                        margin: 0 auto !important;
                                        border-radius: 40px !important;
                                    }
            </style>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <separator string="Datos personales "/>

                    <group>
                        <group>
                            <field name="nom_paciente"></field>
                            <field name="fecha_nacimiento"></field>
                            <field name="dni"></field>
                            <field name="telf_principal"></field>
                            <field name="pais"></field>
                            <field name="municipio"></field>
                        </group>
                        <group>
                            <field name="ape_paciente"></field>
                            <field name="edad"></field>
                            <field name="email"></field>
                            <field name="telf_emergencia"></field>
                            <field name="estado"></field>
                            <field name="direccion"></field>
                        </group>
                    </group>
                    <separator string="Datos medicos"/>
                    <group>
                        <group>
                            <field name="tratamiento_medico" 
                                    widget="boolean_toggle"></field>
                            <field name="tipo_tratamiento" 
                                    invisible="tratamiento_medico == False"></field>
                        </group>
                        <group>
                            <field name="prop_hemorragia"></field>
                        </group>
                        <group>
                            <field name="alergia_medicamento" 
                                widget="boolean_toggle"></field>
                            <field name="desc_alergia_medicamento"
                                    invisible="alergia_medicamento == False"></field>
                        </group>
                        <group>
                        <field name="problemas_anesteciaBucal" 
                                widget="boolean_toggle"></field>   
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_pacientes" model="ir.actions.act_window">
        <field name="name">Pacientes</field>
        <field name="res_model">pacientes</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Registra tu primer paciente!
            </p>
        </field>
    </record>
    <record id="view_partner_form_inherit_paciente" model="ir.ui.view">
    <field name="name">res.partner.form.inherit.paciente</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
        
        <xpath expr="//field[@name='vat']" position="after">
            <field name="es_paciente" widget="boolean_toggle"/>
        </xpath>
        
    </field>
</record>
</odoo>
