<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jira_synchro_form" model="ir.ui.view">
        <field name="name">jira.synchro.form</field>
        <field name="model">jira.synchro</field>
        <field name="arch" type="xml">
            <form string="Sincronizar Jira">
                <sheet>
                    <p class="text-muted">Sincronización automática desde la API de Jira.</p>
                    <group>
                        <group string="Fechas">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group string="Credenciales">
                            <field name="jira_url"/>
                            <field name="jira_email"/>
                            <field name="jira_api_token" password="True"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_sync_jira" string="Sincronizar Ahora" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_excel_import_form" model="ir.ui.view">
        <field name="name">excel.timesheet.import.form</field>
        <field name="model">excel.timesheet.import</field>
        <field name="arch" type="xml">
            <form string="Cargar Partes de Horas desde Excel">
                <sheet>
                    <p class="text-muted">Seleccione el archivo Excel con las horas trabajadas.</p>
                    <group>
                        <field name="excel_file" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import_excel" string="Subir y Procesar" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_jira_synchro_v19" model="ir.actions.act_window">
        <field name="name">Sincronización de Jira</field>
        <field name="res_model">jira.synchro</field>
        <field name="view_mode">form</field>
        <field name="target">new</field> 
    </record>

    <record id="action_excel_import_v19" model="ir.actions.act_window">
        <field name="name">Carga desde Excel</field>
        <field name="res_model">excel.timesheet.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field> 
    </record>

    <menuitem id="menu_carga_data_root_v19" name="Carga de Data" parent="hr_timesheet.timesheet_menu_root" sequence="45"/>
    <menuitem id="menu_carga_data_group_v19" name="Fuentes Externas" parent="menu_carga_data_root_v19" sequence="10"/>
    
    <menuitem id="menu_jira_sync_final" name="Sincronizar desde Jira" parent="menu_carga_data_group_v19" action="action_jira_synchro_v19" sequence="10"/>
    <menuitem id="menu_excel_sync_final" name="Carga desde Excel" parent="menu_carga_data_group_v19" action="action_excel_import_v19" sequence="20"/>
</odoo>