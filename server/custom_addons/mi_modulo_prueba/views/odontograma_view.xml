<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Popup para cuando se quiera editar una línea del odontograma manualmente -->
    <record id="view_odontograma_form_popup" model="ir.ui.view">
        <field name="name">odontograma.linea.popup</field>
        <field name="model">odontograma.linea</field>
        <field name="arch" type="xml">
            <form string="Detalle de Hallazgo Dental">
                <sheet>
                    <h2 class="text-center" style="color:#00A09D;">Registro de Pieza Dental</h2>
                    <group>
                        <group>
                            <field name="diente_numero" readonly="1"/>
                            <field name="procedimiento"/>
                        </group>
                        <group>
                            <field name="cara"/>
                        </group>
                    </group>
                    <separator string="Notas Médicas"/>
                    <field name="notas" placeholder="Anotaciones adicionales sobre este diente..."/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>