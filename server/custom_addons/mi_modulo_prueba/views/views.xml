<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_historia_paciente_list" model="ir.ui.view">
        <field name="name">historia.paciente.list</field>
        <field name="model">historia.paciente</field>
        <field name="arch" type="xml">
            <list string="Lista de Pacientes">
                <field name="CI"/>
                <field name="nom_paciente" />
                <field name="ape_paciente" />
                <field name="edad"/>
                <field name="fechaHistoria"/>
                <field name="tipServ"/>
                <field name="consultorio"/>
                <field name="motivo"/>
            </list>
        </field>
    </record>

    <record id="view_historia_paciente_form" model="ir.ui.view">
        <field name="name">historia.paciente.form</field>
        <field name="model">historia.paciente</field>
        <field name="arch" type="xml">
            <form string="Historia Clínica del Paciente">
                <sheet>
                    <style>
                        .o_form_sheet { 
                            max-width: 85% !important; 
                            margin: 0 auto !important; 
                            border-radius: 15px !important; 
                            box-shadow: 0 4px 20px rgba(0,0,0,0.1) !important;
                        }
                    </style>
                    
                    <div class="oe_title">
                        <label for="name" string="Código de Historia"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Información del Paciente">
                            <field name="paciente_id" options="{'no_create': True}"/>
                            <field name="CI"/>
                            <field name="edad"/>
                        </group>
                        <group string="Contacto">
                            <field name="telf"/>
                            <field name="email"/>
                        </group>
                    </group>

                    <separator string="⚠️ Alertas Médicas" 
                               invisible="not trat_medico and not prop_hemorragia and not alergia_medicamento and not problemas_anesteciaBucal" 
                               class="text-danger"/>
                    
                    <group invisible="not trat_medico and not prop_hemorragia and not alergia_medicamento and not problemas_anesteciaBucal">
                        <group string="Clínica">
                            <field name="trat_medico" widget="boolean_toggle"/>
                            <field name="tipo_tratamiento" invisible="not trat_medico"/>
                            <field name="prop_hemorragia" widget="boolean_toggle"/>
                        </group>
                        <group string="Reacciones">
                            <field name="alergia_medicamento" widget="boolean_toggle"/>
                            <field name="desc_alergia_medicamento" invisible="not alergia_medicamento"/>
                            <field name="problemas_anesteciaBucal" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <separator string="Detalles de la Consulta"/>
                    <group>
                        <group>
                            <field name="tipServ"/>
                            <field name="consultorio"/>
                        </group>
                        <group>
                            <field name="fechaHistoria"/>
                            <field name="motivo"/>
                        </group>
                    </group>
                    
                    <separator string="Asistente de Voz IA (Grabar Consulta)"/>
                    <p class="text-muted mb-3">Presione el micrófono para grabar la consulta médica. La IA extraerá los datos y generará el resumen escrito.</p>
                    
                    <!-- AQUI USAMOS EL NUEVO WIDGET CREADO -->
                    <group>
                        <field name="audio_file" widget="audio_recorder" nolabel="1"/>
                    </group>

                    <field name="examenHecho" 
                           placeholder="Aquí aparecerá la transcripción y el resumen de la consulta una vez procesado por la IA..." 
                           style="min-height: 100px; margin-top: 15px;"/>
                    
                    <div class="mt-2 mb-4">
                        <button name="action_completar_con_ia" 
                                string="🪄 Extraer Datos con IA" 
                                type="object" 
                                class="btn-primary" 
                                icon="fa-magic"
                                confirm="¿Procesar grabación y autocompletar la historia clínica?"/>
                    </div>

                    <separator string="ODONTOGRAMA" class="mt-4 mb-3 text-primary h4"/>
                    <div class="o_odontograma_container" style="background: #f8f9fa; border-radius: 10px; padding: 10px;">
                        <field name="odontograma_line_ids" 
                               widget="odontograma_widget" 
                               nolabel="1" 
                               colspan="2"/>
                    </div>

                    <group string="Detalle de Procedimientos">
                        <field name="odontograma_line_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="diente_numero"/>
                                <field name="procedimiento"/>
                                <field name="cara"/>
                                <field name="notas"/>
                            </list>
                        </field>
                    </group>

                    <notebook>
                        <page string="Seguimiento de Tratamientos" name="page_tratamientos">
                            <field name="tratamiento_ids">
                                <list editable="bottom">
                                    <field name="sesion"/>
                                    <field name="fecha"/>
                                    <field name="tratamiento"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form> 
        </field>
    </record>

    <record id="action_historia_paciente" model="ir.actions.act_window">
        <field name="name">Historias de Pacientes</field>
        <field name="res_model">historia.paciente</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <menuitem id="menu_clinica_root" name="Clínica" sequence="10" web_icon="fa fa-hospital-o"/>
    <menuitem id="menu_pacientes_categoria" name="Gestión Médica" parent="menu_clinica_root" sequence="10"/>
    <menuitem id="menu_pacientes_accion" name="Historial Médico" parent="menu_pacientes_categoria" action="action_historia_paciente" sequence="10"/>
</odoo>